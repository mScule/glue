var AGE_LIMIT = 18

var user = func (name age) {
  return dict {
    name = name or ""
    age  = age  or 0
  }
}

var is_old_enough = func (user) {
    return user.age >= AGE_LIMIT
}

var bounce = func (user) {
    if !is_old_enough(user) {
        return user.name + " has to wait for " + (AGE_LIMIT - user.age)
    }
    return user.name + " is old enough. Welcome!"
}

var users = list {
    user("Baby")
    user("Mike" 15)
    user("Jack" 20)
    user("Bill" 30)
    user("Granpa" 100)
}

for user in users {
    console.log(bounce(user))
}
