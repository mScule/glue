var possibly_crashing = func (crashes) {
    if (crashes) {
        fail("Crash happened!!")
    }

    return dict { name = "Mike" age = 50 }
}

var { res1 err1 } = attempt(func () {
    return possibly_crashing(true)
})

if err1 {
    print("First run failed with: " + err1.msg)
}

var { res2 } = attempt(func () {
    return possibly_crashing(false)
})

print("Name " + res2.name + " Age " + res2.age)
